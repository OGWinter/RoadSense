PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/roadsense
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=24h
CLIENT_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=100
NODE_ENV=development

# Optional overrides:
# REDIS_URL=redis://127.0.0.1:6379
# Storage configuration (local | cloudinary | s3)
STORAGE_PROVIDER=local

# Cloudinary Storage (Free 25GB, recommended for Vercel/Render deployment)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
# Alternatively:
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Gmail Email Service (for email verification & forgot password)
# Create Gmail App Password: Google Account > Security > 2FA > App Passwords
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx
CLIENT_URL=http://localhost:5173

# S3_BUCKET=roadsense-uploads
# S3_REGION=us-east-1
# S3_ENDPOINT=https://s3.amazonaws.com
